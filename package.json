{
  "name": "youtube-playlist-downloader",
  "version": "1.1.0",
  "description": "A tool for downloading YouTube playlists, channels, or individual videos in high-quality using yt-dlp and ffmpeg.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MazenMohamed05/yt-dlp-gui.git"
  },
  "bugs": {
    "url": "https://github.com/MazenMohamed05/yt-dlp-gui/issues"
  },
  "homepage": "https://github.com/MazenMohamed05/yt-dlp-gui#readme",
  "license": "MIT",
  "keywords": [
    "youtube",
    "playlist",
    "downloader",
    "yt-dlp",
    "ffmpeg"
  ],
  "author": "Mazen Mohamed (Original by Amir Haytham)",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mazenmohamed.youtubeplaylistdownloader",
    "productName": "YouTube Playlist Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "*.exe",
          "!*.old"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "YouTube Playlist Downloader",
      "publisherName": "Mazen Mohamed"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YouTube Playlist Downloader"
    }
  }
}
